## loops.kuza — три вида циклов

## Обратный отсчёт: while
:count = 3;
while<count > 0> >> [
  log >> "Осталось: " + count;
  :count = count - 1;
]

## Сумма чисел: for со счётчиком
:total = 0;
for<:i = 1; i <= 10; i++> >> [
  :total = total + i;
]
log >> "Сумма 1..10 = " + total;

## Перебор массива: foreach
foreach<fruit : ["яблоко", "банан", "вишня"]> >> [
  log >> "Фрукт: " + fruit;
]

## Вложенное условие внутри цикла
foreach<n : [1, 5, 12, 20]> >> [
  ?n > 10 >> [
    log >> n + " — большое число";
  ] || [
    log >> n + " — маленькое число";
  ]
]
