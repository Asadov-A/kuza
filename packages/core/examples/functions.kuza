## functions.kuza — функции и рекурсия

func factorial<n> >> [
  ?n <= 1 >> [
    return 1;
  ]
  return n * factorial<n - 1>;
]

log >> "6! = " + factorial<6>;

func fib<n> >> [
  ?n < 2 >> [
    return n;
  ]
  return fib<n - 1> + fib<n - 2>;
]

foreach<i : [0, 1, 2, 3, 4, 5, 6, 7]> >> [
  log >> "fib(" + i + ") = " + fib<i>;
]

func greet<name> >> [
  return "Привет, " + name + "!";
]
log >> greet<"Kuza">;
