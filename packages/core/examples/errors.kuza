## errors.kuza — ошибки и try/catch

func divide<a, b> >> [
  ?b == 0 >> [
    throw >> "Деление на ноль!";
  ]
  return a / b;
]

try >> [
  log >> "10 / 2 = " + divide<10, 2>;
  log >> "1 / 0 = " + divide<1, 0>;
]
catch<e> >> [
  err >> "Поймали ошибку: " + e.message;
]

## Проверка условий
assert >> <2 + 2 == 4, "математика сломалась">;
log >> "Проверки прошли";
