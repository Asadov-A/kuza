{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kuza: запустить расширение",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode",
        "${workspaceFolder}/packages/core/examples"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode/dist/**/*.js"],
      "preLaunchTask": "kuza: build"
    }
  ]
}
